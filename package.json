{
  "name": "@cnips/table",
  "version": "1.0.3",
  "description": "cnips Table Accessor - TypeScript client for cnips table operations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cnips",
    "table",
    "accessor"
  ],
  "license": "ISC",
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@cnips/simplelog": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnips/table-ts.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
